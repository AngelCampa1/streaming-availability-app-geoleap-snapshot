  "Stripe": {
    "SecretKey": "[Retrieved from User Secrets or Azure Key Vault - NEVER commit actual secret]",
    "PublishableKey": "[Retrieved from User Secrets or Azure Key Vault - NEVER commit actual key]",
    "WebhookSecret": "[Retrieved from User Secrets or Azure Key Vault - NEVER commit actual secret]"
  },
  "MaxMind": {
