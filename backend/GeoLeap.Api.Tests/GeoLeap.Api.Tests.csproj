<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- CRITICAL FIX: Enable preview features to fix TestServer.Application NULL issue -->
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <LangVersion>preview</LangVersion>
    <!-- Suppress CA2252 warnings since we're explicitly enabling preview features -->
    <NoWarn>$(NoWarn);CA2252</NoWarn>
    <!-- DISABLE PARALLELISM TO PREVENT TEST HOST CRASHES -->
    <!-- xUnit runner.json controls this - conflicts were causing hangs -->
    <ParallelizeTestCollections>false</ParallelizeTestCollections>
    <ParallelizeAssembly>false</ParallelizeAssembly>
    <MaxCpuCount>1</MaxCpuCount> <!-- Use single thread to prevent deadlocks -->
    <TestSessionTimeout>60000</TestSessionTimeout> <!-- 1 minute timeout - should be much faster -->

    <!-- Coverage and Analysis Disabled for Speed -->
    <VSTestCollect></VSTestCollect>
    <!-- CONDITIONAL COVERAGE: Enable with ENABLE_COVERAGE=true env var (e.g., in CI/CD) -->
    <!-- Local dev stays fast (~30s), CI/CD gets coverage (~60-90s) -->
    <CollectCoverage Condition="'$(ENABLE_COVERAGE)' == 'true'">true</CollectCoverage>
    <CollectCoverage Condition="'$(ENABLE_COVERAGE)' != 'true'">false</CollectCoverage>
    <RunCodeAnalysis>false</RunCodeAnalysis>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>

    <!-- Performance Optimizations -->
    <RunTestsInPlace>true</RunTestsInPlace>
    <TestProjectDependsOn>Build</TestProjectDependsOn>
    <UseSharedCompilation>true</UseSharedCompilation>
    <RestoreUseSkipNonexistentTargets>true</RestoreUseSkipNonexistentTargets>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>

    <!-- Memory Management for Speed -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainOnlyFileSystem>true</RetainOnlyFileSystem>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Test Discovery Optimization -->
    <VSTestUseMSBuildOutput>false</VSTestUseMSBuildOutput>
    <!-- FIXED: VSTest logger configuration - proper syntax -->
    <VSTestLogger>console</VSTestLogger>

    <!-- CRITICAL FIX: Additional test execution optimizations -->
    <VSTestCollect></VSTestCollect>
    <TestTimeout>10000</TestTimeout> <!-- 10 second timeout per test - much faster with singleton -->
    <RunTestsInPlace>true</RunTestsInPlace>
    <TestCaseFilter></TestCaseFilter>

    <!-- Memory and performance optimizations -->
    <TestHostLogs>false</TestHostLogs>
    <TestHostTracing>false</TestHostTracing>
    <TestAdaptersPaths></TestAdaptersPaths>
    <TestRunRecords>false</TestRunRecords>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="FluentAssertions" Version="8.6.0" />
    <PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
    <PackageReference Include="Hangfire.MemoryStorage" Version="1.8.1.2" />
    <PackageReference Include="MessagePack" Version="3.1.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.1" />
    <PackageReference Include="WireMock.Net" Version="1.6.9" />
    <PackageReference Include="Selenium.WebDriver" Version="4.27.0" />
    <PackageReference Include="Selenium.WebDriver.ChromeDriver" Version="132.0.6834.8300" />
    <PackageReference Include="Selenium.Support" Version="4.27.0" />
    <PackageReference Include="NBomber" Version="5.7.0" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeoLeap.Api\GeoLeap.Api.csproj" />
  </ItemGroup>

