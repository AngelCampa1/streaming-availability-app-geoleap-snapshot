#!/usr/bin/env bash
set -euo pipefail

# ============================================================================
# GeoLeap — Pre-commit Hook
# Runs quality gates on staged changes before allowing a commit.
# Backend, frontend, and mobile checks run in parallel when multiple are touched.
# ============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() { echo -e "${YELLOW}>>>${NC} $1"; }
ok()   { echo -e "${GREEN}OK:${NC} $1"; }

REPO_ROOT=$(git rev-parse --show-toplevel)
STAGED=$(git diff --cached --name-only)

check_backend=false
check_frontend=false
check_mobile=false

echo "$STAGED" | grep -q "^backend/"  && check_backend=true
echo "$STAGED" | grep -q "^frontend/" && check_frontend=true
echo "$STAGED" | grep -q "^mobile/"   && check_mobile=true

if [ "$check_backend" = false ] && [ "$check_frontend" = false ] && [ "$check_mobile" = false ]; then
    ok "No backend/frontend/mobile changes — skipping quality gates"
    exit 0
fi

TMPDIR_HOOKS=$(mktemp -d)
trap 'rm -rf "$TMPDIR_HOOKS"' EXIT

# ── Backend checks ───────────────────────────────────────────────────────────

run_backend() {
    local log="$TMPDIR_HOOKS/backend.log"
    {
        info "Running backend checks..."

        command -v dotnet >/dev/null 2>&1 || { echo -e "${RED}PRE-COMMIT FAILED:${NC} dotnet CLI not found."; return 1; }

        info "Building backend..."
        (cd "$REPO_ROOT/backend" && dotnet build --verbosity quiet --nologo) \
            || { echo -e "${RED}PRE-COMMIT FAILED:${NC} dotnet build failed"; return 1; }
        ok "Backend build passed"

        info "Running backend tests..."
        (cd "$REPO_ROOT/backend" && dotnet test --verbosity quiet --nologo --no-build) \
            || { echo -e "${RED}PRE-COMMIT FAILED:${NC} Backend tests failed"; return 1; }
        ok "Backend tests passed"
    } > "$log" 2>&1
}

# ── Frontend checks ──────────────────────────────────────────────────────────

run_frontend() {
    local log="$TMPDIR_HOOKS/frontend.log"
    {
        info "Running frontend checks..."

        FRONTEND_DIR="$REPO_ROOT/frontend"

        if [ ! -d "$FRONTEND_DIR/node_modules" ]; then
            info "node_modules missing — running npm install..."
            (cd "$FRONTEND_DIR" && npm install --quiet) || { echo -e "${RED}PRE-COMMIT FAILED:${NC} npm install failed"; return 1; }
        fi

        info "Running lint (staged files only)..."
        STAGED_FRONTEND_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep "^frontend/.*\.[jt]sx\?$" | sed "s|^frontend/||" || true)
        if [ -n "$STAGED_FRONTEND_FILES" ]; then
            LINT_ARGS=()
            while IFS= read -r file; do
                LINT_ARGS+=("$file")
            done <<< "$STAGED_FRONTEND_FILES"
            (cd "$FRONTEND_DIR" && npx eslint "${LINT_ARGS[@]}") \
                || { echo -e "${RED}PRE-COMMIT FAILED:${NC} Lint failed"; return 1; }
        fi
        ok "Lint passed"

        info "Running typecheck..."
        (cd "$FRONTEND_DIR" && npm run typecheck) \
            || { echo -e "${RED}PRE-COMMIT FAILED:${NC} Typecheck failed"; return 1; }
        ok "Typecheck passed"

        info "Running frontend tests..."
        (cd "$FRONTEND_DIR" && npm test -- --watchAll=false --passWithNoTests --maxWorkers=2) \
            || { echo -e "${RED}PRE-COMMIT FAILED:${NC} Frontend tests failed"; return 1; }
        ok "Frontend tests passed"

        info "Running frontend build..."
        (cd "$FRONTEND_DIR" && npm run build) \
            || { echo -e "${RED}PRE-COMMIT FAILED:${NC} Frontend build failed"; return 1; }
        ok "Frontend build passed"
    } > "$log" 2>&1
}

# ── Mobile checks ────────────────────────────────────────────────────────────

run_mobile() {
    local log="$TMPDIR_HOOKS/mobile.log"
    {
        info "Running mobile checks..."

        MOBILE_DIR="$REPO_ROOT/mobile"

        if [ ! -d "$MOBILE_DIR/node_modules" ]; then
            info "node_modules missing — running npm install..."
            (cd "$MOBILE_DIR" && npm install --quiet) || { echo -e "${RED}PRE-COMMIT FAILED:${NC} npm install failed"; return 1; }
        fi

        info "Running mobile lint..."
        (cd "$MOBILE_DIR" && npm run lint) \
            || { echo -e "${RED}PRE-COMMIT FAILED:${NC} Mobile lint failed"; return 1; }
        ok "Mobile lint passed"

        info "Running mobile typecheck..."
        (cd "$MOBILE_DIR" && npm run typecheck) \
            || { echo -e "${RED}PRE-COMMIT FAILED:${NC} Mobile typecheck failed"; return 1; }
        ok "Mobile typecheck passed"

        info "Running mobile tests..."
        (cd "$MOBILE_DIR" && npm test -- --watchAll=false --passWithNoTests --forceExit) \
            || { echo -e "${RED}PRE-COMMIT FAILED:${NC} Mobile tests failed"; return 1; }
        ok "Mobile tests passed"
    } > "$log" 2>&1
}

# ── Run checks in parallel ───────────────────────────────────────────────────

PIDS=()

if [ "$check_backend" = true ]; then
    run_backend &
    PIDS+=($!)
fi

if [ "$check_frontend" = true ]; then
    run_frontend &
    PIDS+=($!)
fi

if [ "$check_mobile" = true ]; then
    run_mobile &
    PIDS+=($!)
fi

FAILED=0
for pid in "${PIDS[@]}"; do
    if ! wait "$pid"; then
        FAILED=1
    fi
done

# Print all logs in order
for track in backend frontend mobile; do
    if [ -f "$TMPDIR_HOOKS/$track.log" ]; then
        cat "$TMPDIR_HOOKS/$track.log"
    fi
done

if [ "$FAILED" -ne 0 ]; then
    echo ""
    echo -e "${RED}PRE-COMMIT FAILED:${NC} One or more checks failed — commit blocked."
    exit 1
fi

echo ""
ok "All quality gates passed — proceeding with commit"
