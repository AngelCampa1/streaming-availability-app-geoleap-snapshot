{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "cross-env PORT=3020 next dev --turbopack",
    "dev:webpack": "cross-env PORT=3020 next dev",
    "build": "next build --webpack",
    "build:webpack": "next build --webpack",
    "build:safe": "next build --webpack",
    "build:analyze": "cross-env ANALYZE=true next build --turbopack",
    "build:analyze:webpack": "cross-env ANALYZE=true next build --webpack",
    "start": "cross-env PORT=3020 next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "seo:quality": "node scripts/seo-quality-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "preview": "opennextjs-cloudflare build && node scripts/patch-opennext-cloudflare.mjs && wrangler dev",
    "deploy": "opennextjs-cloudflare build && node scripts/patch-opennext-cloudflare.mjs && wrangler deploy --keep-vars"
  },
  "dependencies": {
    "@microsoft/signalr": "^9.0.6",
    "@opennextjs/cloudflare": "1.19.10",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-oauth/google": "^0.12.2",
    "@stripe/react-stripe-js": "^3.9.2",
    "@stripe/stripe-js": "^7.9.0",
    "@tanstack/react-query": "^5.67.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.3",
    "dotenv": "^17.2.3",
    "i18next": "^25.5.2",
    "lodash": "^4.17.21",
    "lucide-react": "^0.541.0",
    "next": "16.2.6",
    "react": "19.1.0",
    "react-apple-signin-auth": "^1.1.2",
    "react-day-picker": "^9.9.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.0.0",
    "react-intersection-observer": "^9.14.0",
    "react-window": "^1.8.11",
    "react-window-infinite-loader": "^1.0.10",
    "recharts": "^3.2.0",
    "streaming-availability": "^4.4.0",
    "tailwind-merge": "^3.3.1",
    "web-vitals": "^4.2.4"
  },
  "optionalDependencies": {
    "@ast-grep/napi-linux-x64-gnu": "0.40.5",
    "@img/sharp-libvips-linux-x64": "1.2.4",
    "@img/sharp-linux-x64": "0.34.5",
    "lightningcss-linux-x64-gnu": "1.30.1"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.2",
    "@eslint/eslintrc": "^3",
    "@microsoft/applicationinsights-react-js": "^19.3.8",
    "@microsoft/applicationinsights-web": "^3.3.11",
    "@next/bundle-analyzer": "16.2.6",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/gtag.js": "^0.0.20",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-window": "^1.8.8",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jest": "^30.0.5",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.0.5",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0",
    "msw": "^2.12.2",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5",
    "whatwg-fetch": "^3.6.20",
    "wrangler": "4.92.0"
  }
}
