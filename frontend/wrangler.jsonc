{
  "name": "geoleap-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "expose_global_message_channel"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/dashboard", "/dashboard/*", "/settings", "/settings/*", "/support", "/support/*", "/upgrade", "/upgrade/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "geoleap.app",
      "zone_name": "geoleap.app",
      "custom_domain": true
    },
    {
      "pattern": "www.geoleap.app",
      "zone_name": "geoleap.app",
      "custom_domain": true
    }
  ]
}
