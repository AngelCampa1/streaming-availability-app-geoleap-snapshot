# GeoLeap Environment Variables Example
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL password used by docker-compose.dev.yml
POSTGRES_PASSWORD=GeoLeap123!

# PostgreSQL connection (defaults match docker-compose.dev.yml, which publishes
# the container's 5432 on host port 9020)
POSTGRES_HOST=localhost
POSTGRES_PORT=9020
POSTGRES_DB=GeoLeap_Dev
POSTGRES_USER=postgres

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis Password (Optional - leave empty for development)
REDIS_PASSWORD=

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# JWT Secret (REQUIRED - minimum 64 characters for production)
JWT_SECRET=your-super-secret-jwt-key-minimum-64-characters-for-production-use

# JWT Configuration
JWT_ISSUER=GeoLeap.Api
JWT_AUDIENCE=GeoLeap.Client
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# =============================================================================
# OAUTH PROVIDERS
# =============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple OAuth
APPLE_CLIENT_ID=com.yourcompany.geoleap
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key.p8

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================
# TMDb API Key (for streaming content data)
TMDB_API_KEY=your-tmdb-api-key

# Streaming Availability API
STREAMING_AVAILABILITY_API_KEY=your-streaming-availability-api-key

# =============================================================================
# APPLICATION INSIGHTS (Optional)
# =============================================================================
APPLICATION_INSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key-here

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3020,http://localhost:3000

# =============================================================================
# PUBLIC FORM ABUSE PROTECTION
# =============================================================================
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TRUSTED_PROXY=true

# =============================================================================
# ENVIRONMENT
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# MOCK SERVICES (Development Only)
# =============================================================================
# Set to true ONLY in development - MUST be false in production
USE_MOCK_OAUTH=false
USE_MOCK_EMAIL=true
USE_MOCK_SMS=true

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. NEVER use these example values in production
# 2. Generate strong random passwords for all services
# 3. Use a secrets management service (Azure Key Vault, AWS Secrets Manager, etc.) in production
# 4. Rotate credentials regularly
# 5. Use different credentials for each environment (dev/staging/prod)
