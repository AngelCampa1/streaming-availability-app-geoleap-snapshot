# Expo Configuration
# Copy this file to .env and fill in your values

# EAS Project ID (get from https://expo.dev after running `eas init`)
EAS_PROJECT_ID=your-project-id-here

# Expo Username
EXPO_OWNER=your-expo-username

# App Configuration
APP_VARIANT=development  # development | preview | production
APP_VERSION=1.0.0
BUILD_NUMBER=1
VERSION_CODE=1

# API Configuration
# REQUIRED: Production backend URL - NO LOCALHOST SUPPORT
# BUG-005 FIX: Remove /api suffix - endpoints already include it
EXPO_PUBLIC_API_URL=https://api.geoleap.app

# OAuth Configuration (required for social login)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
EXPO_PUBLIC_APPLE_CLIENT_ID=app.geoleap.service

# Apple Configuration (for iOS builds and submissions)
# Get these from Apple Developer Portal
APPLE_ID=your-apple-id@example.com
APPLE_TEAM_ID=your-apple-team-id
ASC_APP_ID=your-app-store-connect-app-id

# Android Configuration
# Path to your Google Play service account JSON file
GOOGLE_SERVICE_ACCOUNT_PATH=./google-service-account.json

# Streaming Availability API Configuration
# Get your API key from https://rapidapi.com/movie-of-the-night-movie-of-the-night-default/api/streaming-availability
# REQUIRED for content search and streaming availability features
EXPO_PUBLIC_STREAMING_API_KEY=your-streaming-availability-api-key

# Sentry Configuration (optional - crash reporting and performance monitoring)
# Get DSN from https://sentry.io after creating a project
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
