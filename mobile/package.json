{
  "name": "geoleap-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:native": "react-native run-android",
    "ios:native": "react-native run-ios",
    "build:android:dev": "eas build --platform android --profile development",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:prod": "eas build --platform android --profile production",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:prod": "eas build --platform ios --profile production",
    "build:all:prod": "eas build --platform all --profile production",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "submit:all": "eas submit --platform all",
    "update": "eas update",
    "update:preview": "eas update --branch preview",
    "update:production": "eas update --branch production",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "cross-env NODE_OPTIONS=\"--max-old-space-size=24576\" jest --runInBand --forceExit --detectOpenHandles",
    "test:memory-intensive": "cross-env NODE_OPTIONS=\"--max-old-space-size=24576\" jest src/__tests__/hooks/api/useApi.test.ts --runInBand",
    "smoke-test": "ts-node scripts/smoke-test.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-native-voice/voice": "^3.2.4",
    "@react-navigation/bottom-tabs": "^7.7.3",
    "@react-navigation/drawer": "^7.7.2",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.8.5",
    "@react-navigation/stack": "^7.6.2",
    "@sentry/react-native": "~7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.6",
    "axios": "^1.13.2",
    "babel-preset-expo": "~54.0.0",
    "expo": "^54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.11",
    "expo-auth-session": "^7.0.10",
    "expo-clipboard": "^8.0.8",
    "expo-constants": "~18.0.12",
    "expo-crypto": "^15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.10",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.15",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "^14.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.15",
    "expo-web-browser": "^15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-aes-crypto": "^2.1.0",
    "react-native-config": "^1.5.9",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-iap": "^14.7.6",
    "react-native-keychain": "^8.1.1",
    "react-native-paper": "^5.14.5",
    "react-native-permissions": "^5.4.4",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.15.0",
    "react-native-worklets": "^0.5.1",
    "streaming-availability": "^4.4.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.9",
    "@react-native/eslint-config": "0.76.9",
    "@react-native/metro-config": "0.76.9",
    "@react-native/typescript-config": "0.76.9",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^18.0.0",
    "@types/uuid": "^10.0.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.19.0",
    "fast-text-encoding": "^1.0.6",
    "jest": "^29.6.3",
    "msw": "^2.12.4",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "2.8.8",
    "react-native-url-polyfill": "^3.0.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.46.3"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "@react-native-voice/voice": {
      "@expo/config-plugins": "~9.0.0"
    },
    "@xmldom/xmldom": "^0.9.10",
    "fast-xml-parser": "^5.8.0",
    "postcss": "^8.5.15"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "listUnknownPackages": false,
        "exclude": [
          "react-native-aes-crypto",
          "react-native-vector-icons",
          "streaming-availability"
        ]
      }
    }
  }
}
